{
  "name": "@tenora/orm",
  "version": "1.0.0-canary.0",
  "description": "Eloquent-inspired ORM for Tenora with ambient, per-connection transactions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node -e \"require('node:fs').existsSync('dist/index.js') || (console.error('Tenora: run npm run build first.'), process.exit(1))\"",
    "lint": "echo 'add your linter'"
  },
  "keywords": [
    "tenora",
    "orm",
    "multi-tenant",
    "postgres",
    "mysql",
    "mariadb",
    "sqlite",
    "sqlserver"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "kysely": "0.29.8"
  },
  "peerDependencies": {
    "better-sqlite3": ">=12",
    "mariadb": "^3.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "tedious": ">=18"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mariadb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "tedious": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViktorVelikov13/tenora.git",
    "directory": "packages/orm"
  },
  "homepage": "https://github.com/ViktorVelikov13/tenora#readme",
  "bugs": {
    "url": "https://github.com/ViktorVelikov13/tenora/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
