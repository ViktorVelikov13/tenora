{
  "name": "@tenora/multi-tenant",
  "version": "1.0.0-canary.0",
  "description": "Reusable multi-tenant helper for Knex + Objection",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tenora": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node -e \"require('node:fs').existsSync('dist/index.js') || (console.error('Tenora: run npm run build first.'), process.exit(1))\"",
    "lint": "echo 'add your linter'"
  },
  "keywords": [
    "knex",
    "objection",
    "multi-tenant",
    "postgres"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tenora/core": "^1.0.0-canary.0",
    "@tenora/orm": "^1.0.0-canary.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViktorVelikov13/tenora.git",
    "directory": "packages/multi-tenant"
  },
  "homepage": "https://github.com/ViktorVelikov13/tenora#readme",
  "bugs": {
    "url": "https://github.com/ViktorVelikov13/tenora/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  }
